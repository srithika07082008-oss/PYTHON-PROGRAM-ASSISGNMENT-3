import copy
import sys
import time

rows, cols = 3, 4

bad = [[0] * cols] * rows
bad[0][1] = 7

good = [[0 for _ in range(cols)] for _ in range(rows)]
good[0][1] = 7

print("bad:", bad)
print("good:", good)
print(bad[0] is bad[1], good[0] is good[1])

stops = {
    (13.0827, 80.2707): "Chennai Central",
    (13.0418, 80.2341): "T. Nagar"
}
print(stops[(13.0418, 80.2341)])

# Tuple immutability does not make a nested list immutable.
t = ([1, 2], "bus stop")
t[0].append(3)
print("tuple containing list:", t)

original = [[1, 2], [3, 4]]
alias = original
shallow = copy.copy(original)
slice_copy = original[:]
deep = copy.deepcopy(original)
original[0][0] = 99
print("alias:", alias)
print("shallow:", shallow)
print("slice:", slice_copy)
print("deep:", deep)

# List cannot be used as a dictionary key:
try:
    locations = {[13.0418, 80.2341]: "T. Nagar"}
except TypeError as e:
    print("Error:", e)

# Memory/time comparison (illustrative; depends on Python build and machine).
values_list = list(range(1_000_000))
values_tuple = tuple(values_list)
print("List shallow size:", sys.getsizeof(values_list))
print("Tuple shallow size:", sys.getsizeof(values_tuple))

t0 = time.perf_counter()
_ = values_list[500_000]
list_index_time = time.perf_counter() - t0
t0 = time.perf_counter()
_ = values_tuple[500_000]
tuple_index_time = time.perf_counter() - t0
print("Index times:", list_index_time, tuple_index_time)
