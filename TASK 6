def trains_at_station(data, station, day):
    result = []
    for number, details in data.items():
        if day in details["days"]:
            for stop, arrival, departure in details["stops"]:
                if stop.lower() == station.lower():
                    result.append((number, details["name"], arrival, departure))
    return result

def sort_departures(trains):
    return sorted(trains, key=lambda item: item[3])

def build_station_index(data):
    index = defaultdict(list)
    for number, details in data.items():
        for station, arrival, departure in details["stops"]:
            index[station.lower()].append(number)
    return dict(index)

def print_timetable(data):
    for number, details in data.items():
        print(number, "-", details["name"], "| days:", sorted(details["days"]))
        for station, arrival, departure in details["stops"]:
            print("   ", station, arrival, departure)

